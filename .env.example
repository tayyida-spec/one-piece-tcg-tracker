# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres — use Supabase connection string (Settings → Database → URI, mode: Transaction)
# Add ?pgbouncer=true&connection_limit=1 for serverless if using pooler port 6543
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection for Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Shared invite code for friends to join Three Hats workspace (set any secret phrase)
WORKSPACE_INVITE_CODE=three-hats-2026
